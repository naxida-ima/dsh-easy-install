<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DshSwitch.SwitchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DeepSeek Harness 开关">

    <Grid Background="{ThemeResource BgBrush}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Padding="24,18,24,0">
            <TextBlock Text="DeepSeek Harness" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" />
            <TextBlock x:Name="VerText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- 大圆开关 -->
        <Grid Grid.Row="1" Tapped="SwitchTapped" HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="250" Height="250">
            <Ellipse x:Name="GlowRing" Width="250" Height="250" Fill="#1A8A93A8" />
            <Ellipse x:Name="OuterRing" Width="210" Height="210" Fill="#141B1E33"
                     Stroke="#33808A90" StrokeThickness="2" />
            <Ellipse x:Name="InnerCircle" Width="168" Height="168" Fill="#2E252A4C" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon x:Name="PowerIcon" Glyph="&#xE945;" FontSize="52"
                          Foreground="#C6CBDC" HorizontalAlignment="Center" />
                <TextBlock x:Name="OnOffText" Text="OFF" FontSize="22" FontWeight="SemiBold"
                           Foreground="#C6CBDC" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- 状态 -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="2">
            <TextBlock x:Name="StateText" Text="正在检查状态…" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="PortText" Text="界面地址：http://127.0.0.1:3080" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,14,0,0">
            <Button x:Name="WebBtn" Content="打开界面" MinWidth="130" Padding="18,8"
                    Style="{StaticResource AccentButtonStyle}" Click="WebBtn_Click" />
            <ToggleSwitch x:Name="AutoSwitch" Header="开机自动运行" OnContent="" OffContent=""
                          MinWidth="150" Toggled="AutoSwitch_Toggled" />
        </StackPanel>

        <!-- 底部 -->
        <Grid Grid.Row="5" Padding="24,6,24,18">
            <Button x:Name="UninstallBtn" Content="卸载 DeepSeek Harness" Padding="10,4"
                    Background="Transparent" Foreground="#8B90B8"
                    HorizontalAlignment="Left" Click="UninstallBtn_Click" />
            <TextBlock Text="关闭窗口后开关仍会最小化到任务栏" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
