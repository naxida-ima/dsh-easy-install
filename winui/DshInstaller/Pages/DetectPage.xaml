<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DshInstaller.Pages.DetectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,20,32,10" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="TitleText" Text="正在检查你的电脑…" FontSize="24" FontWeight="Bold" />
            <ProgressRing x:Name="Spinner" Width="22" Height="22" IsActive="True" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ItemPanel" Spacing="8" Margin="0,6,0,0" />
        </ScrollViewer>

        <Border Grid.Row="2" x:Name="SummaryCard" Background="#EEF0FF" CornerRadius="12"
                Padding="18,12" Visibility="Collapsed">
            <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" Foreground="#3A3F6B" />
        </Border>
    </Grid>
</UserControl>
