<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 调色板 ============ -->
    <SolidColorBrush x:Key="BrandBrush" Color="#4D6BFE" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="#6D85FF" />
    <SolidColorBrush x:Key="BrandPressedBrush" Color="#3B55D8" />
    <SolidColorBrush x:Key="BgBrush" Color="#F4F5FB" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E6F0" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D2E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#9AA0B8" />
    <SolidColorBrush x:Key="GreenBrush" Color="#2EA05A" />
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#E6F6ED" />
    <SolidColorBrush x:Key="AmberBrush" Color="#C88C1E" />
    <SolidColorBrush x:Key="RedBrush" Color="#DC3C46" />
    <SolidColorBrush x:Key="BlueSoftBrush" Color="#EDF0FF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EDEEF5" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F2FA" />

    <!-- ============ 圆角 ============ -->
    <CornerRadius x:Key="CardCorner">14</CornerRadius>
    <CornerRadius x:Key="BtnCorner">8</CornerRadius>

    <!-- ============ 基础控件 ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    </Style>

    <!-- 主按钮 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource BtnCorner}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮 -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#EEF0F7" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource BtnCorner}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E2E5F0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D5D9E8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCorner}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="1" Opacity="0.08" Color="#4A5578" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 步骤圆点 -->
    <Style x:Key="StepCircle" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="#E2E5F0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 滚动条 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
    </Style>

    <!-- 进度条 -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="#E4E7F2" />
        <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>
