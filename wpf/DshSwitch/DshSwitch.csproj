<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DshSwitch</RootNamespace>
    <AssemblyName>switch</AssemblyName>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\DshInstaller\Core\Paths.cs" Link="Core\Paths.cs" />
    <Compile Include="..\DshInstaller\Core\Detector.cs" Link="Core\Detector.cs" />
    <Compile Include="..\DshInstaller\Core\DshService.cs" Link="Core\DshService.cs" />
    <Compile Include="..\DshInstaller\Core\Installer.cs" Link="Core\Installer.cs" />
    <Compile Include="..\DshInstaller\Core\Bundle.cs" Link="Core\Bundle.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon.ico" />
  </ItemGroup>
</Project>
