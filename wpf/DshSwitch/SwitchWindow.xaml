<Window x:Class="DshSwitch.SwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek Harness 开关"
        Width="500" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Microsoft YaHei UI"
        Closing="Window_Closing">

    <Border Background="{StaticResource BgBrush}" CornerRadius="14"
            BorderBrush="#D5D9E8" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="4" Opacity="0.22" Color="#3A4468" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="#FFFFFF" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource BrandBrush}">
                        <TextBlock Text="⚡" FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="DeepSeek Harness" FontSize="14" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="VerText" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                               Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="─" Width="40" Height="44" FontSize="13" Background="Transparent"
                            BorderThickness="0" Foreground="#6B7280" Click="MinBtn_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F0F2FA" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Width="44" Height="44" FontSize="12" Background="Transparent"
                            BorderThickness="0" Foreground="#6B7280" Click="CloseBtn_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#DC3C46" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 主体 -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 大圆开关 -->
                <Border x:Name="SwitchOuter" Width="248" Height="248" CornerRadius="124"
                        MouseLeftButtonDown="Switch_MouseDown" Cursor="Hand">
                    <Border x:Name="SwitchCore" Width="176" Height="176" CornerRadius="88"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="#4A5578" BorderThickness="2">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PowerText" Text="⏻" FontSize="58" Foreground="#C6CBDC"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="OnOffText" Text="OFF" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#C6CBDC" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Border>

                <StackPanel Margin="0,22,0,0">
                    <TextBlock x:Name="StateText" Text="正在检查状态…" FontSize="19" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="PortText" Text="界面地址：http://127.0.0.1:3080" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button x:Name="WebBtn" Content="打开界面" MinWidth="130"
                            Style="{StaticResource PrimaryButton}" Click="WebBtn_Click" />
                    <ToggleButton x:Name="AutoToggle" Content="开机自启" Margin="16,0,0,0"
                                  MinWidth="120" Checked="AutoToggle_Checked" Unchecked="AutoToggle_Unchecked">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#EEF0F7" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Padding" Value="18,8" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="{StaticResource BtnCorner}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E2E5F0" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E6F6ED" />
                                                    <Setter Property="Foreground" Value="#2EA05A" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
            </StackPanel>

            <!-- 底部 -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="20,10,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="卸载 DeepSeek Harness" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextDimBrush}" FontSize="11.5"
                            HorizontalAlignment="Left" Click="UninstallBtn_Click" />
                    <TextBlock Grid.Column="1" Text="关闭窗口后仍会在托盘运行" FontSize="11.5"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
