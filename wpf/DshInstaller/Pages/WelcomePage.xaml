<UserControl x:Class="DshInstaller.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,34,44,20">
            <TextBlock Text="欢迎使用 DeepSeek Harness" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="DeepSeek 官方出品的 AI 智能体工作台" FontSize="16"
                       Foreground="{StaticResource BrandBrush}" Margin="0,4,0,26" />

            <Border Style="{StaticResource Card}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="这是一个能帮你自动完成任务的 AI 助手工具：" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="· 安装过程完全自动化，跟着提示点「下一步」即可" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock Text="· 所有必需文件（含 Node.js 运行时）已打包在安装程序里，无需联网下载" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock Text="· 装好后桌面上有一个「开关」，随时可以看到它是开还是关" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock Text="· 程序只在本机运行，不占用系统权限，卸载也只需点一下" FontSize="14" />
                </StackPanel>
            </Border>

            <Border Background="#EDF0FF" CornerRadius="14" Padding="26,20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="电脑要求（安装时会自动检测）" FontSize="14" FontWeight="SemiBold"
                               Foreground="#3A3F6B" Margin="0,0,0,8" />
                    <TextBlock Text="· Windows 10 或 11（64 位）" FontSize="13" Foreground="#5A5F85" Margin="0,0,0,5" />
                    <TextBlock Text="· 内存 4GB 以上，磁盘剩余 1.5GB 以上" FontSize="13" Foreground="#5A5F85" Margin="0,0,0,5" />
                    <TextBlock Text="· 任意浏览器（如 Edge、Chrome）" FontSize="13" Foreground="#5A5F85" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
