<UserControl x:Class="DshInstaller.Pages.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,28,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="开始安装" FontSize="22" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="DeepSeek Harness 必需的全部文件（含 Node.js 运行时）都已打包在安装程序里，无需联网、无需另外安装任何东西。"
                   FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,16" />

        <TextBlock x:Name="PhaseText" Grid.Row="2" Text="准备就绪，点击「开始安装」" FontSize="15" Margin="0,0,0,8" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="InstBar" Height="10" Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="PctText" Grid.Column="1" Text="0%" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Width="46"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,10,0,12"
                 Background="#F9FAFD" BorderBrush="{StaticResource DividerBrush}" />

        <Button x:Name="StartBtn" Grid.Row="5" Content="🚀 开始安装" Height="46"
                Style="{StaticResource PrimaryButton}" Click="StartBtn_Click" />
    </Grid>
</UserControl>
