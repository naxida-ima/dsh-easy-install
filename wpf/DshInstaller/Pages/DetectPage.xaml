<UserControl x:Class="DshInstaller.Pages.DetectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,28,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" Text="正在检查你的电脑…" FontSize="22" FontWeight="Bold" />
            <ProgressBar x:Name="Spinner" Width="110" Height="4" Margin="18,0,0,0"
                         IsIndeterminate="True" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ItemPanel" Margin="0,4,0,0" />
        </ScrollViewer>

        <Border x:Name="SummaryCard" Grid.Row="2" Background="#EDF0FF" CornerRadius="12"
                Padding="20,14" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" Foreground="#3A3F6B" />
        </Border>
    </Grid>
</UserControl>
