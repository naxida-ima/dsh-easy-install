<UserControl x:Class="DshInstaller.Pages.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="40,20,40,10" HorizontalAlignment="Center" Width="720">
        <Border Width="92" Height="92" CornerRadius="46" Background="#33D68F" HorizontalAlignment="Center">
            <TextBlock Text="✓" FontSize="46" Foreground="White" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock Text="安装完成！" FontSize="28" FontWeight="Bold" Foreground="#2EA05A"
                   HorizontalAlignment="Center" Margin="0,16,0,6" />
        <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18" />

        <Border Style="{StaticResource Card}" Padding="26,20">
            <StackPanel>
                <TextBlock Text="接下来怎么做？" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="1. 桌面上已经放好了「DeepSeek Harness 开关」" FontSize="13.5" Margin="0,0,0,7" />
                <TextBlock Text="2. 点击「立即启动」，程序会自动打开浏览器界面" FontSize="13.5" Margin="0,0,0,7" />
                <TextBlock Text="3. 在浏览器界面里填入你的 DeepSeek API Key，就可以开始对话了" FontSize="13.5" Margin="0,0,0,7" TextWrapping="Wrap" />
                <TextBlock Text="4. 以后想开就点开关，想关也点开关，开关上能直接看到运行状态" FontSize="13.5" Margin="0,0,0,7" TextWrapping="Wrap" />
                <TextBlock Text="（开关会常驻屏幕右下角托盘，开机自动运行，随时可看状态）" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" />
            </StackPanel>
        </Border>

        <Button x:Name="LaunchBtn" Content="🚀 立即启动" Height="50" FontSize="15" FontWeight="SemiBold"
                Background="#33D68F" HorizontalAlignment="Center" MinWidth="240" Margin="0,22,0,0"
                Click="LaunchBtn_Click" />
    </StackPanel>
</UserControl>
